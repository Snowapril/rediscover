# Local Supabase stack. Copy to .env and fill in before running `supabase start`.
#
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Kakao: https://developers.kakao.com — the REST API key is the client id.
#   Redirect URI: http://127.0.0.1:54321/auth/v1/callback
#   Consent items: profile_nickname, profile_image, account_email
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
