{
  "name": "rediscover",
  "private": true,
  "version": "0.0.0",
  "description": "Scrap links, organize them, and actually come back to read them.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
