  "devDependencies": {
    "@types/node": "22.15.3",
    "eslint": "9.28.0",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vitest": "3.1.3"
  }
}
